{
  "name": "tokenresearch-codex-guide",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir dist/client",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "build:client": "vite build --outDir dist/client",
    "start": "node --env-file-if-exists=.env server/self-host.mjs",
    "build:worker": "node scripts/build.mjs",
    "test:server": "node --test tests/self-host.test.mjs",
    "format": "prettier --write src server/self-host.mjs tests/self-host.test.mjs",
    "test:pricing": "node --test tests/pricing.test.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "6.4.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.44.0",
    "motion": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
